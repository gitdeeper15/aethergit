{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AetherGit/validation/formal_definition_schema",
  "title": "Formal Definition Validation",
  "description": "Validates that a formal definition is complete and consistent with the AetherGit framework.",
  "type": "object",
  "required": ["definition_id", "name", "statement", "components", "status"],
  "properties": {
    "definition_id": {
      "type": "string",
      "enum": ["D1", "D2", "D3"]
    },
    "name": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["defined", "pending", "invalid"]
    },
    "consistency": {
      "type": "object",
      "properties": {
        "dag_topology": { "type": "boolean" },
        "changeset_tuple": { "type": "boolean" },
        "recursion_terminates": { "type": "boolean" },
        "immutability_enforced": { "type": "boolean" }
      }
    }
  }
}
